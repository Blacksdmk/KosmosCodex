{
  "rules": {
    ".read": false,
    "codex": {
      "races": { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
      "reports": { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    }
  }
}
